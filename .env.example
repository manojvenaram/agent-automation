# ==========================================
# YouTube Shorts Automation Agent Configuration
# ZERO PAID APIS - All local/free defaults
# ==========================================

# Application Environment
ENVIRONMENT=development
DEMO_MODE=false
AUTO_PUBLISH=false

# Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=false

# LLM Configuration (Ollama - Local AI)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.7

# Text-to-Speech (TTS)
# Options: edge-tts (free neural cloud), pyttsx3 (local offline SAPI5), piper
TTS_ENGINE=edge-tts
TTS_VOICE=en-US-ChristopherNeural
TTS_RATE=+0%
TTS_PITCH=+0Hz

# Video Specifications (YouTube Shorts Target)
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
MIN_DURATION=20
MAX_DURATION=60
TARGET_WORDS_PER_MINUTE=145

# Quality Control & Safety
FACT_CONFIDENCE_THRESHOLD=0.80
MINIMUM_QUALITY_SCORE=75
MAX_REPAIR_ATTEMPTS=3

# Subtitles / Captions
CAPTION_FONT_SIZE=64
CAPTION_POSITION=bottom_safe
CAPTION_MAX_WORDS_PER_LINE=4

# YouTube Publishing Settings
YOUTUBE_CLIENT_SECRETS_FILE=credentials/client_secrets.json
YOUTUBE_TOKEN_FILE=credentials/token.pickle
YOUTUBE_PRIVACY_STATUS=private
YOUTUBE_CATEGORY_ID=28

# Scheduler
SCHEDULER_ENABLED=false
POSTING_TIME=18:00
TIMEZONE=UTC
